# Copy this file to .env and fill it in. Never commit .env.

# Token from @BotFather. Use your OWN test bot while developing.
BOT_TOKEN=

# Telegram user IDs of the admins, separated by commas (e.g. 111111111,222222222).
# Get yours from @userinfobot.
INITIAL_ADMIN_IDS=

# Optional. The 🌐 button under replies opens https://cckfupm.vercel.app/ by default.
# Set this only to point it somewhere else. Must start with https://
# WEBSITE_URL=
